# Names and placeholders only. Copy to env/dev.env and fill in locally (Annex J.5.1).
# One project, one container and one volume per environment: each file fixes its own name.
COMPOSE_PROJECT_NAME=csp-dev
# Identity: the public key every service validates tokens with, and the token
# csp-worker presents.
# In develop, ./scripts/dev-keys.sh fills both in.
JWT_PUBLIC_KEY=
SERVICE_TOKEN=
# Subjects csp-auth-api allows on its internal operations, comma-separated. Must match the sub of the service token
# of csp-worker.
SERVICE_SUBJECTS=csp-worker
# Purge of expired auth records (ADR-030): csp-worker calls csp-auth-api with its service token. On in develop,
# where scripts/dev-keys.sh writes that token.
PURGE_AUTH_ENABLED=true

# The single PostgreSQL instance (Annex J). The administrator only runs the instance and the bootstrap script; the
# migration executors connect as <domain>_migrator (booking_migrator, auth_migrator), owners of their schema.
PG_DATABASE=csp
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
# Login users of the domains: created by postgres/init/01-instance.sh, used by the services.
BOOKING_APP_PASSWORD=
# Login of the migration executor of csp-booking-db (<domain>_migrator): owns the booking schema and has CREATEROLE.
BOOKING_MIGRATOR_PASSWORD=
# Login of the migration executor of csp-auth-db: owns the auth schema and has CREATEROLE.
AUTH_MIGRATOR_PASSWORD=
# AUTH_APP_PASSWORD goes inside APP_AUTH_DATABASE_URL, so it must be URL-safe: openssl rand -hex 24
AUTH_APP_PASSWORD=
WORKER_APP_PASSWORD=

# csp-booking-db (migration executor, as booking_migrator) and csp-booking-api (its own user, never the administrator).
BOOKING_DB_USER=booking_migrator
BOOKING_DB_PASSWORD=${BOOKING_MIGRATOR_PASSWORD}
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/${PG_DATABASE}
SPRING_DATASOURCE_USERNAME=booking_app
SPRING_DATASOURCE_PASSWORD=${BOOKING_APP_PASSWORD}

# csp-auth-db (migration executor, as auth_migrator) and csp-auth-api (its own user, never the administrator).
AUTH_DB_USER=auth_migrator
AUTH_DB_PASSWORD=${AUTH_MIGRATOR_PASSWORD}
APP_AUTH_DATABASE_URL=postgres://auth_app:${AUTH_APP_PASSWORD}@postgres:5432/${PG_DATABASE}
# The RS256 private key csp-auth-api signs tokens with, in one line with literal \n escapes.
# In develop, ./scripts/dev-keys.sh fills it in; the same pair validates in the other services.
APP_AUTH_JWT_PRIVATE_KEY=

# The single MongoDB instance (Annex J), defined by csp-infra-mongo and composed above. The migration executor of
# csp-catalog-db logs in as catalog_migrator (CATALOG_DB_USER), which owns catalog_db and nothing else; csp-catalog-api
# logs in as catalog_app, which has no role of its own: csp-catalog-db grants it catalog_writer when it migrates.
# CATALOG_APP_PASSWORD goes inside the MONGODB_URI of csp-catalog-api, so it must be URL-safe: openssl rand -hex 24
# WORKER_APP_PASSWORD above is also the password of worker_app in MongoDB. The key file is one line of base64:
# openssl rand -base64 48 | tr -d '\n'
MONGO_ADMIN_USER=mongo_admin
MONGO_ADMIN_PASSWORD=
MONGO_KEYFILE=
MONGO_HOST=mongodb
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_migrator
CATALOG_DB_PASSWORD=
CATALOG_APP_PASSWORD=

# The single Redis instance (Annex J), defined by csp-infra-redis and composed above. It keeps the auth state
# (attempt counters, temporary lockout, revoked jti) and has no persistence. Login users: redis_admin (operation) and
# auth_app, limited to the keys attempts:*, locked:* and blacklist:*. AUTH_REDIS_PASSWORD goes inside APP_AUTH_REDIS_URL,
# so it must be URL-safe: openssl rand -hex 24
REDIS_ADMIN_PASSWORD=
AUTH_REDIS_PASSWORD=
APP_AUTH_REDIS_URL=redis://auth_app:${AUTH_REDIS_PASSWORD}@redis:6379/0

# SMTP relay of csp-auth-api (ADR-034): it sends the code of the email change. Without a host the two routes answer 404.
# Development: the local catcher, `docker compose --profile mail up mailpit` (messages at http://localhost:8025). To try a real
# provider, replace these values in your git-ignored env/dev.env: the user and the password are secrets and never go in this file.
APP_AUTH_SMTP_HOST=mailpit
APP_AUTH_SMTP_PORT=1025
APP_AUTH_SMTP_TLS=none
APP_AUTH_SMTP_FROM=no-reply@cinesync.local
APP_AUTH_SMTP_USER=
APP_AUTH_SMTP_PASSWORD=
# Optional, development only: Mailpit that also relays the messages to a real SMTP provider (profile `mail-relay` of csp-auth-api).
# The service keeps the values above (it talks to Mailpit, never to the provider), so an expired key only fails the relay; an unreachable or
# slow provider keeps Mailpit waiting and the email change answers 500 (README), so set APP_AUTH_SMTP_TIMEOUT=15s in your env/dev.env and,
# if the provider is down, use the profile `mail`. To renew the key or change provider, change these variables and run
# ./scripts/mailpit-relay.sh again. Only the recipients
# that match MAILPIT_RELAY_MATCHING (a regular expression) reach the provider. The user and the password are secrets: set them only in
# your git-ignored env/dev.env. The sender APP_AUTH_SMTP_FROM must be a sender that the provider has verified.
MAILPIT_RELAY_HOST=
MAILPIT_RELAY_PORT=587
MAILPIT_RELAY_STARTTLS=true
MAILPIT_RELAY_USER=
MAILPIT_RELAY_PASSWORD=
MAILPIT_RELAY_MATCHING=

# The API gateway (csp-api-gateway, composed above): the only service published to the host, on port 8000. It reads one
# variable, the browser origins it allows (CORS), as a regex the gateway anchors as ^...$. Development: the shell on 4200 and
# the remotes on 4201-4205.
APP_GATEWAY_CORS_ORIGIN_REGEX=http://localhost:(4200|4201|4202|4203|4204|4205)

# Open Grafana dashboards without a login: only in develop.
GRAFANA_ANONYMOUS=true
