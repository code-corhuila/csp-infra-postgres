# Names and placeholders only. Copy to env/main.env and fill in locally (Annex J.5.1).
# One project, one container and one volume per environment: each file fixes its own name.
COMPOSE_PROJECT_NAME=csp-main
# Identity: the public key every service validates tokens with, and the token
# csp-worker presents.
# In main they come from the identity service, as secrets: never these files.
JWT_PUBLIC_KEY=
SERVICE_TOKEN=

# The single PostgreSQL instance (Annex J). The migration executor of csp-booking-db connects with the
# administrator, because its first migrations create the schema and the roles.
PG_DATABASE=csp
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
# Login users of the domains: created by postgres/init/01-instance.sh, used by the services.
BOOKING_APP_PASSWORD=
AUTH_APP_PASSWORD=
WORKER_APP_PASSWORD=

# csp-booking-db (migration executor) and csp-booking-api (its own user, never the administrator).
BOOKING_DB_USER=${PG_ADMIN_USER}
BOOKING_DB_PASSWORD=${PG_ADMIN_PASSWORD}
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/${PG_DATABASE}
SPRING_DATASOURCE_USERNAME=booking_app
SPRING_DATASOURCE_PASSWORD=${BOOKING_APP_PASSWORD}

# csp-auth-db (migration executor, with the administrator as booking's) and csp-auth-api (its own user, never the
# administrator). The password goes inside a URL, so it must be URL-safe: openssl rand -hex 24
AUTH_DB_USER=${PG_ADMIN_USER}
AUTH_DB_PASSWORD=${PG_ADMIN_PASSWORD}
APP_AUTH_DATABASE_URL=postgres://auth_app:${AUTH_APP_PASSWORD}@postgres:5432/${PG_DATABASE}
# The RS256 private key csp-auth-api signs tokens with, in one line with literal \n escapes.
# In main the identity service owner injects it as a secret: never these files.
APP_AUTH_JWT_PRIVATE_KEY=

# The single MongoDB instance (Annex J), defined by csp-infra-mongo and composed above. The migration executor of
# csp-catalog-db logs in as catalog_app, which owns catalog_db and nothing else. WORKER_APP_PASSWORD above is also
# the password of worker_app in MongoDB. The key file is one line of base64: openssl rand -base64 48 | tr -d '\n'
MONGO_ADMIN_USER=mongo_admin
MONGO_ADMIN_PASSWORD=
MONGO_KEYFILE=
MONGO_HOST=mongodb
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_app
CATALOG_DB_PASSWORD=

# Open Grafana dashboards without a login: only in develop.
GRAFANA_ANONYMOUS=false
