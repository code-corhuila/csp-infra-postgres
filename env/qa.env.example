# Names and placeholders only. Copy to env/qa.env and fill in locally (Annex J.5.1).
# One project, one container and one volume per environment: each file fixes its own name.
COMPOSE_PROJECT_NAME=csp-qa
# Identity: the public key every service validates tokens with, and the token
# csp-worker presents.
# In qa they come from the identity service, as secrets: never these files.
JWT_PUBLIC_KEY=
SERVICE_TOKEN=
# Subjects csp-auth-api and csp-booking-api allow on their maintenance operations, comma-separated. Must match the sub of the
# service token of csp-worker.
SERVICE_SUBJECTS=csp-worker
# Purge of expired auth records (ADR-030): csp-worker calls csp-auth-api with its service token. Off until the secret
# manager provides the service token of csp-worker as SERVICE_TOKEN_FILE; then set it to true. On in qa: the token is an
# environment secret, renewed before it expires (runbook of the auth service).
PURGE_AUTH_ENABLED=true

# The single PostgreSQL instance (Annex J). The administrator only runs the instance and the bootstrap script; the
# migration executors connect as <domain>_migrator (booking_migrator, auth_migrator), owners of their schema.
PG_DATABASE=csp
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
# Login users of the domains: created by postgres/init/01-instance.sh, used by the services.
BOOKING_APP_PASSWORD=
# Login of the migration executor of csp-booking-db (<domain>_migrator): owns the booking schema and has CREATEROLE.
BOOKING_MIGRATOR_PASSWORD=
# Login of the migration executor of csp-auth-db: owns the auth schema and has CREATEROLE.
AUTH_MIGRATOR_PASSWORD=
# AUTH_APP_PASSWORD goes inside APP_AUTH_DATABASE_URL, so it must be URL-safe: openssl rand -hex 24
AUTH_APP_PASSWORD=
WORKER_APP_PASSWORD=

# csp-booking-db (migration executor, as booking_migrator) and csp-booking-api (its own user, never the administrator).
BOOKING_DB_USER=booking_migrator
BOOKING_DB_PASSWORD=${BOOKING_MIGRATOR_PASSWORD}
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/${PG_DATABASE}
SPRING_DATASOURCE_USERNAME=booking_app
SPRING_DATASOURCE_PASSWORD=${BOOKING_APP_PASSWORD}
# csp-booking-api, service-only side (ADR-020, ADR-035, ADR-056). WORKFLOW_SUBJECTS lists the subjects allowed on its /internal/workflow/
# family (the workflow service, csp-workflow): empty keeps that family closed. The maintenance family uses SERVICE_SUBJECTS above.
# Catalog is reached inside the platform network, and the credential csp-booking-api presents to it (sub booking-service, iss
# csp-auth, aud csp-internal) is a file on the host that compose mounts read-only at CATALOG_SERVICE_TOKEN_FILE; the service re-reads it
# every 30 s, so a rotated file needs no restart. Without that file the routes that read Catalog (seat map, hold) answer 503.
# In qa the identity service issues that credential as the secret CATALOG_SERVICE_TOKEN: the deployment writes its value to a file
# and CATALOG_SERVICE_TOKEN_HOST_FILE is the absolute path of that file; never the credential itself in this file.
WORKFLOW_SUBJECTS=csp-workflow
CATALOG_BASE_URL=http://catalog-api:8082/api/v1/catalog
CATALOG_SERVICE_TOKEN_FILE=/run/secrets/catalog-service-token
CATALOG_SERVICE_TOKEN_HOST_FILE=

# csp-auth-db (migration executor, as auth_migrator) and csp-auth-api (its own user, never the administrator).
AUTH_DB_USER=auth_migrator
AUTH_DB_PASSWORD=${AUTH_MIGRATOR_PASSWORD}
APP_AUTH_DATABASE_URL=postgres://auth_app:${AUTH_APP_PASSWORD}@postgres:5432/${PG_DATABASE}
# The RS256 private key csp-auth-api signs tokens with, in one line with literal \n escapes.
# In qa the identity service owner injects it as a secret: never these files.
APP_AUTH_JWT_PRIVATE_KEY=

# The single MongoDB instance (Annex J), defined by csp-infra-mongo and composed above. The migration executor of
# csp-catalog-db logs in as catalog_migrator (CATALOG_DB_USER), which owns catalog_db and nothing else; csp-catalog-api
# logs in as catalog_app, which has no role of its own: csp-catalog-db grants it catalog_writer when it migrates.
# CATALOG_APP_PASSWORD goes inside the MONGODB_URI of csp-catalog-api, so it must be URL-safe: openssl rand -hex 24
# WORKER_APP_PASSWORD above is also the password of worker_app in MongoDB. The key file is one line of base64:
# openssl rand -base64 48 | tr -d '\n'
MONGO_ADMIN_USER=mongo_admin
MONGO_ADMIN_PASSWORD=
MONGO_KEYFILE=
MONGO_HOST=mongodb
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_migrator
CATALOG_DB_PASSWORD=
CATALOG_APP_PASSWORD=

# The single Redis instance (Annex J), defined by csp-infra-redis and composed above. It keeps the auth state
# (attempt counters, temporary lockout, revoked jti) and has no persistence. Login users: redis_admin (operation) and
# auth_app, limited to the keys attempts:*, locked:* and blacklist:*. AUTH_REDIS_PASSWORD goes inside APP_AUTH_REDIS_URL,
# so it must be URL-safe: openssl rand -hex 24
# In qa the real values come from the environment secrets: never these files.
REDIS_ADMIN_PASSWORD=
AUTH_REDIS_PASSWORD=
APP_AUTH_REDIS_URL=redis://auth_app:${AUTH_REDIS_PASSWORD}@redis:6379/0

# The single RabbitMQ broker (ADR-036), defined by csp-infra-rabbitmq and composed above: the exchanges cine.events and cine.dlx and one
# login per service. The broker does not start unless the four passwords are set, and they go inside the AMQP URLs, so they must be
# URL-safe: openssl rand -hex 24. worker_relay may only publish to cine.events; RELAY_AMQP_URL is what csp-worker reads to relay.
RABBIT_ADMIN_PASSWORD=
WORKER_RELAY_PASSWORD=
TICKETING_FULFILLMENT_PASSWORD=
CONCESSIONS_PASSWORD=
RELAY_AMQP_URL=amqp://worker_relay:${WORKER_RELAY_PASSWORD}@rabbitmq:5672/%2F
# Outbox relay of csp-auth: publishes UserRegistered and UserEmailChanged to cine.events. Keep it false until the consumers of Ticketing
# are part of the platform and have declared their queues (cine.ticketing_fulfillment.user-registered and .user-email-changed):
# an event published before that is an unroutable permanent failure that waits for an operator (README of csp-worker).
AUTH_OUTBOX_RELAY_ENABLED=false

# SMTP relay of csp-auth-api (ADR-034): it sends the code of the email change. Without a host the two routes answer 404.
# The six values are injected as environment secrets of this environment (APP_AUTH_SMTP_HOST, _PORT, _USER, _PASSWORD, _FROM,
# _TLS): never these files. TLS is starttls on port 587; `none` is for a local catcher only.
APP_AUTH_SMTP_HOST=
APP_AUTH_SMTP_PORT=
APP_AUTH_SMTP_USER=
APP_AUTH_SMTP_PASSWORD=
APP_AUTH_SMTP_FROM=
APP_AUTH_SMTP_TLS=

# Page of the portal that the registration link opens (csp-auth-api, ADR-062): an absolute http(s) URL, as the browser reaches it, without a
# fragment; the mail carries <URL>#token=<token>. Without it, or without the SMTP relay above, POST /register answers as usual but no registration
# can be confirmed. Set here the public address of the shell of this environment followed by /auth/confirm-registration. It is not a secret.
APP_AUTH_REGISTRATION_CONFIRM_URL=

# Page of the portal that the password reset link opens (csp-auth-api, ADR-050): an absolute http(s) URL, as the browser reaches it, without a
# fragment; the mail carries <URL>#token=<token>. Without it, or without the SMTP relay above, the routes POST /forgot-password and POST
# /reset-password answer 404. Set here the public address of the shell of this environment followed by /auth/reset-password. It is not a secret.
APP_AUTH_PASSWORD_RESET_URL=

# The API gateway (csp-api-gateway, composed above): the only service published to the host, on port 8000. It reads one
# variable, the browser origins it allows (CORS), as a regex the gateway anchors as ^...$. Set here the real origins of this
# environment, for example (https://app.example.org|https://admin.example.org), grouped when it has alternatives (placeholder: replace before the first up).
APP_GATEWAY_CORS_ORIGIN_REGEX=https://REPLACE_WITH_THE_ORIGINS_OF_THIS_ENVIRONMENT

# Open Grafana dashboards without a login: only in develop.
GRAFANA_ANONYMOUS=false
